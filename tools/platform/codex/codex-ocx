#!/bin/sh
set -eu

# Explicit OCX route. It never changes the caller's base config and never
# falls back to Native or either Web GPT route.
codex_home=${CODEX_HOME:-"$HOME/.codex"}
state_root=${AICC_STATE_ROOT:-"$HOME/.ai-control-center"}
route_catalog="$state_root/route-launchers/ocx.models.json"
route_model=${AICC_OCX_MODEL:-gpt-5.6-sol}
route_endpoint=http://127.0.0.1:10100/v1
route_health=http://127.0.0.1:10100/healthz
route_ready=http://127.0.0.1:10100/readyz

for argument in "$@"; do
  case "$argument" in
    -c|--config|-c=*|--config=*|-p|--profile|-p=*|--profile=*|-m|--model|-m=*|--model=*|--oss|--local-provider|--local-provider=*|--remote|--remote=*|--remote-auth-token-env|--remote-auth-token-env=*)
      echo "codex-ocx: route/model override is not allowed: $argument" >&2
      exit 64
      ;;
  esac
done

if [ -n "${AICC_NATIVE_CODEX_EXECUTABLE:-}" ]; then
  route_codex=$AICC_NATIVE_CODEX_EXECUTABLE
elif [ -x /Applications/ChatGPT.app/Contents/Resources/codex ]; then
  route_codex=/Applications/ChatGPT.app/Contents/Resources/codex
elif [ -x "$codex_home/packages/standalone/current/bin/codex" ]; then
  route_codex="$codex_home/packages/standalone/current/bin/codex"
else
  echo "codex-ocx: an official Codex binary was not found" >&2
  exit 69
fi

if [ "${1:-}" = "--status" ]; then
  printf '%s\n' "codex=$route_codex" "endpoint=$route_endpoint" "provider=openai" \
    "model=$route_model" "catalog=$route_catalog" "independent_of=17841,17842,native"
  exit 0
fi

if [ ! -s "$route_catalog" ]; then
  echo "codex-ocx: dedicated model catalog is unavailable; run: aicc route-launchers install" >&2
  exit 78
fi

if ! /usr/bin/curl -fsS --max-time 3 "$route_health" >/dev/null \
  || ! /usr/bin/curl -fsS --max-time 3 "$route_ready" \
    | /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin); raise SystemExit(0 if d.get("status")=="ready" else 1)'
then
  echo "codex-ocx: 10100 is not healthy and ready; inspect OCX without changing another route" >&2
  exit 69
fi

exec "$route_codex" \
  -c "openai_base_url=\"$route_endpoint\"" \
  -c 'model_provider="openai"' \
  -c "model_catalog_json=\"$route_catalog\"" \
  -m "$route_model" \
  "$@"
