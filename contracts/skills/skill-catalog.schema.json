{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/skills/skill-catalog.schema.json",
  "title": "Owner-local skill ecosystem catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "scope", "summary", "skills", "duplicateNames"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "required": ["aiccRoot", "codexHome", "projectRoots"],
      "properties": {
        "aiccRoot": { "type": "string" },
        "codexHome": { "type": "string" },
        "projectRoots": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["logicalSkillCount", "byOwner", "aiccDeliveryIssueCount"],
      "properties": {
        "logicalSkillCount": { "type": "integer", "minimum": 0 },
        "byOwner": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "aiccDeliveryIssueCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "owner", "status", "canonicalPath", "deliveryPaths", "resourceCounts", "handoffs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "owner": { "enum": ["codex-system", "aicc", "plugin", "project"] },
          "status": { "enum": ["builtin", "canonical", "installed-enabled", "cached", "project-local"] },
          "canonicalPath": { "type": "string" },
          "deliveryPaths": { "type": "array", "items": { "type": "string" } },
          "projectScope": { "type": ["string", "null"] },
          "plugin": { "type": ["object", "null"] },
          "resourceCounts": {
            "type": "object",
            "required": ["references", "scripts", "assets"],
            "properties": {
              "references": { "type": "integer", "minimum": 0 },
              "scripts": { "type": "integer", "minimum": 0 },
              "assets": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "handoffs": { "type": "array", "items": { "type": "string" } },
          "sameNameOwners": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "duplicateNames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ids"],
        "properties": {
          "name": { "type": "string" },
          "ids": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
