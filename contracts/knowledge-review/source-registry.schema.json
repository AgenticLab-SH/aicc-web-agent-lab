{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/knowledge-review/source-registry.schema.json",
  "title": "AICC official knowledge source registry",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "manualOnly", "automaticApply", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manualOnly": { "const": true },
    "automaticApply": { "const": false },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "seedUrl", "allowedHosts", "allowedPathPrefixes", "contentTypes", "maxPages", "maxBytes", "manualOnly", "automaticApply"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["llms-index", "canonical-html-seed", "single-document"] },
          "seedUrl": { "type": "string", "pattern": "^https://" },
          "allowedHosts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "allowedPathPrefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } },
          "contentTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "maxPages": { "type": "integer", "minimum": 1 },
          "maxBytes": { "type": "integer", "minimum": 1 },
          "manualOnly": { "const": true },
          "automaticApply": { "const": false }
        }
      }
    }
  }
}
