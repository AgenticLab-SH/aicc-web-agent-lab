{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/knowledge-review/candidate.schema.json",
  "title": "AICC knowledge promotion candidate",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "candidateId", "category", "title", "summary", "sourceRefs", "impactFiles", "risk", "validation", "rollback", "status", "automaticApply", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string" },
    "category": { "enum": ["environment", "wiki", "skill", "mcp"] },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "const": "candidate" },
    "automaticApply": { "const": false },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
