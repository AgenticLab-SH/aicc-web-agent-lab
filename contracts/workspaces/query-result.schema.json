{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticlab.example/contracts/workspaces/query-result.schema.json",
  "title": "Workspace snapshot query result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "snapshotId",
    "workspaceId",
    "cacheHit",
    "results",
    "generatedAt",
    "liveFactsIncluded"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^snapshot_[a-f0-9]{64}$" },
    "workspaceId": { "type": "string", "pattern": "^workspace_[a-f0-9]{24}$" },
    "cacheHit": { "type": "boolean" },
    "results": { "type": "array", "minItems": 1, "maxItems": 20 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "liveFactsIncluded": { "const": false }
  }
}
