{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/compatibility/release-matrix.schema.json",
  "title": "Compatibility release matrix",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "policy", "components", "requiredRegression", "requiredDirectRescue"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": ["sequence", "restartBudget", "activeWorkPolicy", "directRescuePolicy", "automaticVersionApply"],
      "properties": {
        "sequence": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "restartBudget": { "type": "integer", "minimum": 0 },
        "activeWorkPolicy": { "type": "string" },
        "directRescuePolicy": { "type": "string" },
        "automaticVersionApply": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "current", "target", "contractVersion", "rollback"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "minLength": 1 },
          "current": { "type": "object", "required": ["version"], "properties": { "version": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
          "target": { "type": "object", "required": ["version"], "properties": { "version": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
          "contractVersion": { "type": "integer", "minimum": 1 },
          "rollback": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "requiredRegression": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "requiredDirectRescue": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": true
}
