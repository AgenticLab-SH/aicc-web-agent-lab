{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/artifacts/artifact.schema.json",
  "title": "Artifact provenance contract",
  "type": "object",
  "required": ["contractVersion", "artifactId", "jobId", "inputSources", "generator", "output", "verification", "sensitivity", "rollbackRef"],
  "properties": {
    "contractVersion": { "type": "integer", "minimum": 1 },
    "artifactId": { "type": "string" },
    "jobId": { "type": "string" },
    "inputSources": { "type": "array", "items": { "type": "object", "required": ["ref", "sha256"], "properties": { "ref": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": true } },
    "generator": { "type": "object", "required": ["tool", "version", "routeId"], "properties": { "tool": { "type": "string" }, "version": { "type": "string" }, "routeId": { "type": "string" } }, "additionalProperties": true },
    "output": { "type": "object", "required": ["ref", "sha256", "mediaType"], "properties": { "ref": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "mediaType": { "type": "string" } }, "additionalProperties": true },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "sensitivity": { "enum": ["public", "internal", "private", "secret-prohibited"] },
    "rollbackRef": { "type": "string" }
  },
  "additionalProperties": true
}
