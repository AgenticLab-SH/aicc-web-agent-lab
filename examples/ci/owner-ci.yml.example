name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  pull-requests: read

jobs:
  test:
    needs: public-safety
    if: needs.public-safety.outputs.code_changed == 'true'
    timeout-minutes: 20
    strategy:
      fail-fast: true
      matrix:
        include:
          - os: ubuntu-latest
            node: 24
          - os: windows-latest
            node: 22
          - os: macos-latest
            node: 22
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          submodules: recursive
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
        with:
          node-version: ${{ matrix.node }}
          cache: npm
          cache-dependency-path: package-lock.json
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
        with:
          python-version: '3.11'
      - run: npm ci
      - if: runner.os != 'Windows'
        run: bash -n install.sh
      - run: npm run check
      - run: npm run test:distribution
      - run: npm test
      - run: npm run smoke
      - run: npm run test:account-manager

  public-safety:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    outputs:
      code_changed: ${{ steps.scope.outputs.code_changed }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
      - name: Classify code changes
        id: scope
        shell: bash
        env:
          EVENT_NAME: ${{ github.event_name }}
          BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.before }}
          HEAD_SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          code_changed=true
          if [[ "$EVENT_NAME" == push || "$EVENT_NAME" == pull_request ]]; then
            if [[ -n "$BASE_SHA" && ! "$BASE_SHA" =~ ^0+$ ]] && git cat-file -e "$BASE_SHA^{commit}" 2>/dev/null; then
              comparison="$BASE_SHA"
              if [[ "$EVENT_NAME" == pull_request ]]; then
                comparison="$(git merge-base "$BASE_SHA" "$HEAD_SHA")"
              fi
              if git diff --name-only -z "$comparison" "$HEAD_SHA" > "$RUNNER_TEMP/aicc-ci-changes"; then
                code_changed=false
                while IFS= read -r -d '' path; do
                  case "$path" in
                    *.md|*.mdx|docs/runtime-evidence/*) ;;
                    *) code_changed=true; break ;;
                  esac
                done < "$RUNNER_TEMP/aicc-ci-changes"
              fi
            fi
          fi
          echo "code_changed=$code_changed" >> "$GITHUB_OUTPUT"
      - name: Reject personal defaults and runtime state
        shell: bash
        run: |
          set -euo pipefail
          if git grep -nE '/Users/[A-Za-z0-9._-]+|C:\\Users\\[A-Za-z0-9._-]+|[A-Za-z0-9._%+-]+@gmail\.com' -- ':!vendor/opencodex/**' ':!test/**' ':!tests/**' ':!**/test/**' ':!**/tests/**'; then
            echo 'Personal path or email found in publishable source.' >&2
            exit 1
          fi
          if git ls-files | grep -E '(^|/)(auth\.json|\.env|.*\.sqlite(-shm|-wal)?|.*\.db|.*\.pem|.*\.key|credentials\.json)$'; then
            echo 'Runtime credential or database file is tracked.' >&2
            exit 1
          fi
      - if: steps.scope.outputs.code_changed == 'true'
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: package-lock.json
      - run: npm ci
        if: steps.scope.outputs.code_changed == 'true'
      - name: Verify public package allowlist and portability
        if: steps.scope.outputs.code_changed == 'true'
        run: npm run test:distribution
      - uses: gitleaks/gitleaks-action@e0c47f4f8be36e29cdc102c57e68cb5cbf0e8d1e # v3
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
